# PostgreSQL (docker compose)
DATABASE_PASSWORD=change-me
# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT — Prompt 03 (access token HS256 + refresh token em cookie)
# Exige >= 32 caracteres. Deixe vazio em dev: o backend gera um segredo
# efêmero no startup (WARNING no log; reiniciar invalida tokens emitidos).
# Em prod (SPRING_PROFILES_ACTIVE=prod) é OBRIGATÓRIA — o startup falha sem ela.
JWT_SECRET=
# Opcionais (defaults entre parênteses)
JWT_ACCESS_TTL_SECONDS=900    # 15 min
JWT_REFRESH_TTL_DAYS=7        # 7 dias
JWT_COOKIE_NAME=refresh_token
JWT_COOKIE_PATH=/api/v1/auth
JWT_COOKIE_SECURE=false       # prod força true
JWT_COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
